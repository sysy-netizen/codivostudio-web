---
interface Props {
	variant?: 'solid' | 'outline';
	label?: string;
}

const { variant = 'solid', label = '문의하기' } = Astro.props;
---

<div class="contact-widget" data-contact-widget>
	<button
		type="button"
		class={`contact-toggle contact-toggle--${variant}`}
		data-contact-toggle
		aria-expanded="false"
		aria-controls="contact-panel"
	>
		{label}
	</button>

	<div class="contact-accordion" id="contact-panel" data-contact-panel>
		<div class="contact-accordion__inner">
			<form class="contact-form" data-contact-form>
				<input type="hidden" name="access_key" value="4315b321-6c19-4c4c-9ed4-01308b80c20e" />
				<input type="hidden" name="subject" value="Codivo Studio 문의" />
				<div class="contact-form__row">
					<label class="contact-form__field">
						<span>이름</span>
						<input type="text" name="name" required />
					</label>
					<label class="contact-form__field">
						<span>이메일</span>
						<input type="email" name="email" required />
					</label>
				</div>
				<label class="contact-form__field">
					<span>문의 내용</span>
					<textarea name="message" rows="4" required></textarea>
				</label>
				<button type="submit" class="contact-form__submit">보내기</button>
				<p class="contact-form__status" role="status" aria-live="polite"></p>
			</form>
		</div>
	</div>
</div>

<style>
	.contact-widget {
		display: contents;
	}

	.contact-toggle {
		appearance: none;
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.7rem;
		border-radius: 8px;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		border: 1px solid transparent;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.contact-toggle--solid {
		background: var(--color-accent);
		color: #fff;
	}
	.contact-toggle--solid:hover {
		background: var(--color-highlight);
		transform: translateY(-1px);
	}

	.contact-toggle--outline {
		background: transparent;
		color: #fff;
		border-color: rgba(255, 255, 255, 0.2);
	}
	.contact-toggle--outline:hover {
		border-color: var(--color-highlight);
		color: var(--color-highlight);
	}

	.contact-accordion {
		display: grid;
		grid-template-rows: 0fr;
		width: 100%;
		max-width: 30rem;
		margin-top: 1.5rem;
		transition: grid-template-rows 0.3s ease;
	}

	.contact-accordion.is-open {
		grid-template-rows: 1fr;
	}

	.contact-accordion__inner {
		overflow: hidden;
		min-height: 0;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding-top: 0.5rem;
		text-align: left;
	}

	.contact-form__row {
		display: flex;
		gap: 0.9rem;
	}

	.contact-form__field {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.8);
	}

	.contact-form__field input,
	.contact-form__field textarea {
		font: inherit;
		padding: 0.65rem 0.8rem;
		border-radius: 8px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.06);
		color: #fff;
		resize: vertical;
	}

	.contact-form__field input:focus,
	.contact-form__field textarea:focus {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
	}

	.contact-form__submit {
		align-self: flex-start;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		background: var(--color-accent);
		color: #fff;
		border: 1px solid transparent;
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.contact-form__submit:hover {
		background: var(--color-highlight);
	}

	.contact-form__submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.contact-form__status {
		margin: 0;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.8);
		min-height: 1.2em;
	}

	@media (max-width: 480px) {
		.contact-toggle {
			width: 100%;
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-toggle,
		.contact-accordion {
			transition: none;
		}
	}
</style>

<script>
	function initContactForm(root: ParentNode) {
		const toggleBtn = root.querySelector<HTMLButtonElement>('[data-contact-toggle]');
		const panel = root.querySelector<HTMLElement>('[data-contact-panel]');
		const form = root.querySelector<HTMLFormElement>('[data-contact-form]');
		const status = form?.querySelector<HTMLParagraphElement>('.contact-form__status');
		const submitBtn = form?.querySelector<HTMLButtonElement>('.contact-form__submit');

		toggleBtn?.addEventListener('click', () => {
			const isOpen = panel?.classList.toggle('is-open');
			toggleBtn.setAttribute('aria-expanded', String(Boolean(isOpen)));
		});

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!submitBtn || !status) return;

			submitBtn.disabled = true;
			status.textContent = '전송 중...';

			try {
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: new FormData(form),
				});
				const result = await response.json();

				if (result.success) {
					status.textContent = '문의가 전송되었습니다. 감사합니다!';
					form.reset();
				} else {
					status.textContent = '전송에 실패했습니다. 잠시 후 다시 시도해주세요.';
				}
			} catch {
				status.textContent = '전송에 실패했습니다. 네트워크 연결을 확인해주세요.';
			} finally {
				submitBtn.disabled = false;
			}
		});
	}

	document.querySelectorAll('[data-contact-widget]').forEach((root) => initContactForm(root));
</script>
