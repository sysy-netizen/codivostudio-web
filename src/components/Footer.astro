---
const year = new Date().getFullYear();

const columns = [
	{
		title: '도구',
		links: [
			{ href: '/tools/rank-tracker', label: '실시간 랭킹추적' },
			{ href: '/tools/keyword-analysis', label: '연관 키워드 분석' },
			{ href: 'https://invoice-merge-codivo.streamlit.app/', label: '대량발송 엑셀변환기', external: true },
		],
	},
	{
		title: '리소스',
		links: [{ href: '/blog/', label: '블로그' }],
	},
	{
		title: '회사',
		links: [
			{ href: '/about/', label: '소개' },
			{ href: '/#contact', label: '문의' },
		],
	},
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="footer-brand">
				<a class="footer-brand__logo" href="/">Codivo Studio</a>
				<p class="footer-brand__desc">반복되는 업무를 더 단순하게 만듭니다.</p>
			</div>

			{
				columns.map((col) => (
					<div class="footer-col">
						<p class="footer-col__title">{col.title}</p>
						<ul>
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										target={link.external ? '_blank' : undefined}
										rel={link.external ? 'noopener noreferrer' : undefined}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<p class="footer-copyright">&copy; {year} Codivo Studio. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 3rem;
		background: #fff;
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2.5rem 1.5rem 1.75rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 1.5rem;
		padding-bottom: 1.75rem;
	}

	.footer-brand__logo {
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.footer-brand__desc {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 24ch;
	}

	.footer-col__title {
		margin: 0 0 0.6rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-col a {
		font-size: 0.85rem;
		color: var(--color-muted);
		text-decoration: none;
	}

	.footer-col a:hover {
		color: var(--color-accent);
	}

	.footer-copyright {
		margin: 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.8rem;
		color: var(--color-subtle);
		text-align: center;
	}

	@media (max-width: 720px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			row-gap: 1.75rem;
		}
	}

	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
