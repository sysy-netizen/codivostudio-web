---
const year = new Date().getFullYear();

const siteLinks = [
	{ href: '/', label: '홈' },
	{ href: '/tools/', label: '도구' },
	{ href: '/blog/', label: '블로그' },
	{ href: '/about/', label: '소개' },
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<nav class="footer-nav" aria-label="사이트 메뉴">
			<ul>
				{
					siteLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p>&copy; {year} Codivo Studio. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 3rem;
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		text-align: center;
	}

	.footer-nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-nav a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.footer-nav a:hover {
		color: var(--color-accent);
	}

	.footer-inner p {
		margin: 0;
	}
</style>
