---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p>&copy; {year} Codivo Studio. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 3rem;
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		text-align: center;
	}
</style>
