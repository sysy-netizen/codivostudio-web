---
const navItems: { href: string; label: string; external?: boolean }[] = [
	{ href: '/', label: '홈' },
	{ href: '/tools/', label: '도구' },
	{ href: '/about/', label: '소개' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="header-inner">
		<a class="logo" href="/">
			<img class="logo__mark" src="/images/logo-header.png" alt="Codivo Studio" width="1222" height="200" />
		</a>
		<nav id="mobile-nav">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class={currentPath === item.href ? 'active' : ''}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li class="nav-mobile-only"><a href="/#contact">문의하기</a></li>
			</ul>
		</nav>
		<div class="header-actions">
			<a class="btn-outline" href="/#contact">문의하기</a>
			<a class="btn-solid" href="/tools/">도구 둘러보기</a>
			<button class="menu-toggle" id="menu-toggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-nav">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const nav = document.getElementById('mobile-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>

<style>
	.site-header {
		background: var(--color-text);
		border-bottom: 1px solid #222;
		position: relative;
		z-index: 50;
	}

	.header-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 72px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		justify-self: start;
	}

	.logo__mark {
		display: block;
		height: 34px;
		width: auto;
	}

	nav ul {
		display: flex;
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		display: inline-block;
		text-decoration: none;
		color: rgba(255, 255, 255, 0.85);
		font-size: 1rem;
		padding-bottom: 0.35rem;
		border-bottom: 2px solid transparent;
	}

	nav a:hover,
	nav a.active {
		color: var(--color-accent);
	}
	nav a.active {
		border-color: var(--color-accent);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		justify-self: end;
	}

	.btn-outline,
	.btn-solid {
		display: inline-flex;
		align-items: center;
		font-size: 1rem;
		font-weight: 600;
		padding: 0.55rem 1rem;
		border-radius: 6px;
		text-decoration: none;
		white-space: nowrap;
	}

	.btn-outline {
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.25);
	}
	.btn-outline:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.btn-solid {
		color: #fff;
		background: var(--color-accent);
	}
	.btn-solid:hover {
		opacity: 0.9;
	}

	.menu-toggle {
		display: none;
		background: none;
		border: none;
		color: #fff;
		padding: 0.4rem;
		cursor: pointer;
	}

	.nav-mobile-only {
		display: none;
	}

	@media (max-width: 720px) {
		.header-inner {
			position: relative;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--color-text);
			border-bottom: 1px solid #222;
			padding: 0.25rem 1.5rem 0.75rem;
		}

		nav.is-open {
			display: block;
		}

		nav ul {
			flex-direction: column;
			gap: 0;
		}

		nav li {
			border-top: 1px solid rgba(255, 255, 255, 0.08);
		}

		nav a {
			display: block;
			padding: 0.85rem 0;
			border-bottom: none;
		}

		.nav-mobile-only {
			display: list-item;
		}

		.logo__mark {
			height: 26px;
		}

		.btn-outline,
		.btn-solid {
			display: none;
		}

		.menu-toggle {
			display: inline-flex;
		}
	}
</style>
