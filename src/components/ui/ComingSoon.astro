---
interface Props {
	title: string;
	description: string;
	backHref?: string;
	backLabel?: string;
}

const { title, description, backHref = '/tools/', backLabel = '다른 도구 보러 가기 →' } = Astro.props;
---

<section class="coming-soon">
	<span class="coming-soon__badge">Coming Soon</span>
	<h1 class="coming-soon__title">{title}</h1>
	<p class="coming-soon__desc">{description}</p>
	<a class="coming-soon__link" href={backHref}>{backLabel}</a>
</section>

<style>
	.coming-soon {
		padding: 4rem 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1rem;
	}

	.coming-soon__badge {
		display: inline-flex;
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		color: var(--color-muted);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.coming-soon__title {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.coming-soon__desc {
		margin: 0;
		max-width: 42ch;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.coming-soon__link {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}
	.coming-soon__link:hover {
		color: var(--color-highlight);
	}
</style>
