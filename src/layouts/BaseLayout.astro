---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedDate?: Date;
	articleSection?: string;
	keywords?: string;
	noindex?: boolean;
}

const {
	title,
	description = '코디보스튜디오 - AI 도구와 콘텐츠',
	image = '/og-default.svg',
	type = 'website',
	publishedDate,
	articleSection,
	keywords,
	noindex = false,
} = Astro.props;

const siteName = 'Codivo Studio';
const fullTitle = `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site).toString();
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteName,
	url: Astro.site?.toString(),
};

const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: siteName,
	url: Astro.site?.toString(),
	logo: new URL('/codivo-logo.png', Astro.site).toString(),
	description: '코디보스튜디오 - AI 도구와 콘텐츠',
};
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="author" content="Codivo Studio" />
		<meta name="robots" content={robotsContent} />
		<meta name="google-site-verification" content="UtJw8BIg269_5W88jrqFhgvMGB_3RBvAuBMbR381fKk" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />
		<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css" />
		<title>{fullTitle}</title>

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content="ko_KR" />
		{type === 'article' && publishedDate && (
			<meta property="article:published_time" content={publishedDate.toISOString()} />
		)}
		{type === 'article' && articleSection && (
			<meta property="article:section" content={articleSection} />
		)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

		<!-- Google tag (gtag.js) -->
		<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-QB214MSPH9"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', 'G-QB214MSPH9');
		</script>

		<slot name="head" />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #ffffff;
		--color-bg-alt: #f7f7f5;
		--color-text: #0a0a0a;
		--color-muted: #666666;
		--color-subtle: #a3a3a3;
		--color-accent: #ff4f0a;
		--color-highlight: #ff4f0a;
		--color-success: #22c55e;
		--color-border: #e6e6e6;
		--max-width: 1100px;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: 'Pretendard Variable', Pretendard, system-ui, -apple-system, 'Segoe UI', 'Noto Sans KR', sans-serif;
		color: var(--color-text);
		background: var(--color-bg);
		line-height: 1.7;
		letter-spacing: -0.01em;
	}

	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1rem 1.5rem 2rem;
		min-height: 60vh;
	}

	a {
		color: var(--color-accent);
	}
</style>
