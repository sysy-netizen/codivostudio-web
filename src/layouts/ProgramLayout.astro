---
import BaseLayout from './BaseLayout.astro';
import { programs } from '../data/programs';

interface Props {
	title: string;
	description: string;
	relatedHref?: string;
	relatedLabel?: string;
}

const { title, description, relatedHref, relatedLabel } = Astro.props;

const currentPath = Astro.url.pathname;
function isActive(href: string) {
	return currentPath === href || currentPath.startsWith(href);
}
---

<BaseLayout title={title} description={description}>
	<nav class="program-nav" aria-label="Seller Tools 프로그램">
		<ul>
			{
				programs.map((program) => (
					<li>
						<a
							class={`program-link ${isActive(program.href) ? 'is-active' : ''}`}
							href={program.href}
							aria-current={isActive(program.href) ? 'page' : undefined}
						>
							{program.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<section class="tool-page">
		<h1 class="tool-page__title">{title}</h1>
		<p class="tool-page__desc">{description}</p>
		{
			relatedHref && relatedLabel && (
				<p class="tool-page__related">
					관련 글: <a href={relatedHref}>{relatedLabel}</a>
				</p>
			)
		}
		<slot />
	</section>
</BaseLayout>

<style>
	.program-nav {
		margin: 0 0 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.program-nav ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		overflow-x: auto;
	}

	.program-link {
		display: inline-flex;
		align-items: center;
		padding: 0.6rem 0.7rem;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-muted);
		text-decoration: none;
		white-space: nowrap;
		border-bottom: 2px solid transparent;
	}

	.program-link:hover {
		color: var(--color-text);
	}

	.program-link.is-active {
		color: var(--color-accent);
		font-weight: 700;
		border-bottom-color: var(--color-accent);
	}

	.tool-page {
		padding: 0 0 2rem;
		margin-top: -0.5rem;
	}

	.tool-page__title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.tool-page__desc {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.tool-page__related {
		margin: 0 0 1.5rem;
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--color-muted);
	}
</style>
