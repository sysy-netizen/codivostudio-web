---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

const philosophy = [
	{
		title: '단순함',
		desc: '화려한 기능보다 누구나 바로 쓸 수 있는 간단한 구조를 먼저 고려합니다.',
		icon: 'M12 12m-8 0a8 8 0 1 0 16 0a8 8 0 1 0 -16 0',
	},
	{
		title: '실용성',
		desc: '현장에서 오늘 당장 쓸 수 있는지를 기준으로 도구를 만듭니다.',
		icon: 'M14.7 6.3 3 3 M3 21 3.5-1 11-11-2.5-2.5-11 11L3 21Z',
	},
	{
		title: '유지보수',
		desc: '오래 안정적으로 쓸 수 있도록 쉽게 고치고 개선할 수 있게 만듭니다.',
		icon: 'refresh',
	},
	{
		title: '자동화',
		desc: '사람이 반복하던 작업을 도구가 대신하도록 자동화를 우선합니다.',
		icon: 'bolt',
	},
];
---

<BaseLayout title="소개" description="Codivo Studio 소개 - 온라인 셀러와 자동차 실무자를 위한 실용적인 웹 도구를 만드는 이유">
	<section class="about-hero">
		<div class="about-hero__inner">
			<span class="eyebrow">ABOUT CODIVO STUDIO</span>
			<h1 class="about-hero__title">코드가 일상 속에서<br />살아 숨 쉬도록</h1>
			<p class="about-hero__desc">Codivo Studio는 'Code'와 'Vivo(살아있다)'를 합친 이름입니다. 어렵고 딱딱한 코딩이 아니라, 오늘 당장 업무에 쓸 수 있는 실용적인 도구를 만듭니다.</p>
		</div>
	</section>

	<section class="mission">
		<div class="mission__inner">
			<span class="eyebrow">MISSION</span>
			<h2 class="section-title">반복 업무를 단순하게 만드는 이유</h2>
			<p class="mission__desc">코딩이 개발자만의 언어가 아니라, 우리 일상 속에서 살아 숨 쉬게 만드는 것을 목표로 합니다. 반복되는 업무를 자동화하고 싶은 직장인, 코딩을 배우고 싶지만 막막한 비전공자, AI를 업무에 도입하고 싶은 모든 분들을 위해 가장 쉬운 방식으로 다가갑니다. AI 시대, 모두가 AI를 쉽게 활용할 수 있도록 돕는 다리가 되겠습니다.</p>
		</div>
	</section>

	<section class="audience">
		<div class="audience__inner">
			<div class="section-head">
				<span class="eyebrow">WHO WE BUILD FOR</span>
				<h2 class="section-title">온라인 셀러와 자동차 실무자를 위해</h2>
			</div>

			<div class="audience-grid">
				<div class="audience-item">
					<span class="audience-item__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
							<path d="M3 6h18"></path>
							<path d="M16 10a4 4 0 0 1-8 0"></path>
						</svg>
					</span>
					<span class="audience-item__body">
						<span class="audience-item__title">온라인 셀러</span>
						<p class="audience-item__desc">네이버·쿠팡에서 판매하는 셀러가 매일 반복하는 주문 처리, 순위 확인, 키워드 분석 업무를 단순하게 만듭니다.</p>
					</span>
				</div>

				<div class="audience-item">
					<span class="audience-item__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 17h14M5 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm14 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"></path>
							<path d="M3 17V9l2-5h10l4 5v8"></path>
						</svg>
					</span>
					<span class="audience-item__body">
						<span class="audience-item__title">자동차 실무자</span>
						<p class="audience-item__desc">차량 정보 조회 등 자동차 업무에서 반복되는 확인 작업을 더 빠르고 정확하게 처리할 수 있도록 돕습니다.</p>
					</span>
				</div>
			</div>
		</div>
	</section>

	<section class="philosophy">
		<div class="philosophy__inner">
			<div class="section-head">
				<span class="eyebrow">PHILOSOPHY</span>
				<h2 class="section-title">우리가 지키는 원칙</h2>
			</div>

			<div class="philosophy-grid">
				<div class="philosophy-item">
					<span class="philosophy-item__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="8"></circle>
						</svg>
					</span>
					<span class="philosophy-item__title">단순함</span>
					<p class="philosophy-item__desc">화려한 기능보다 누구나 바로 쓸 수 있는 간단한 구조를 먼저 고려합니다.</p>
				</div>

				<div class="philosophy-item">
					<span class="philosophy-item__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m14.7 6.3 3 3L19 8a3 3 0 0 0 0-4l-1-1a3 3 0 0 0-4 0l-1.3 1.3Z"></path>
							<path d="m3 21 3.5-1 11-11-2.5-2.5-11 11L3 21Z"></path>
						</svg>
					</span>
					<span class="philosophy-item__title">실용성</span>
					<p class="philosophy-item__desc">현장에서 오늘 당장 쓸 수 있는지를 기준으로 도구를 만듭니다.</p>
				</div>

				<div class="philosophy-item">
					<span class="philosophy-item__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
							<path d="M21 3v6h-6"></path>
						</svg>
					</span>
					<span class="philosophy-item__title">유지보수</span>
					<p class="philosophy-item__desc">오래 안정적으로 쓸 수 있도록 쉽게 고치고 개선할 수 있게 만듭니다.</p>
				</div>

				<div class="philosophy-item">
					<span class="philosophy-item__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"></path>
						</svg>
					</span>
					<span class="philosophy-item__title">자동화</span>
					<p class="philosophy-item__desc">사람이 반복하던 작업을 도구가 대신하도록 자동화를 우선합니다.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="contact" id="contact">
		<div class="contact__inner">
			<span class="eyebrow eyebrow--light">CONTACT</span>
			<h2 class="contact__title">자유롭게 문의해주세요</h2>
			<p class="contact__desc">궁금한 점이나 제안하고 싶은 아이디어가 있다면 언제든 편하게 남겨주세요. 확인 후 빠르게 답변드리겠습니다.</p>

			<ContactForm variant="solid" />
		</div>
	</section>
</BaseLayout>

<style>
	.about-hero,
	.audience,
	.philosophy,
	.contact {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
	}

	.about-hero__inner,
	.mission__inner,
	.audience__inner,
	.philosophy__inner,
	.contact__inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.eyebrow {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--color-accent);
	}

	.eyebrow--light {
		color: var(--color-highlight);
	}

	.section-title {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.35;
		color: var(--color-text);
	}

	.section-head {
		max-width: 62ch;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin-bottom: 2.5rem;
	}

	/* ── Hero ─────────────────────────────────────── */
	.about-hero {
		background: var(--color-bg-alt);
		padding: 4.5rem 0;
		margin-top: -1rem;
	}

	.about-hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		text-align: center;
	}

	.about-hero__title {
		margin: 0;
		max-width: 20ch;
		font-size: clamp(2rem, 4vw, 2.9rem);
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.about-hero__desc {
		margin: 0;
		max-width: 52ch;
		font-size: clamp(1rem, 1.4vw, 1.1rem);
		line-height: 1.75;
		color: var(--color-muted);
	}

	/* ── Mission (constrained width, no full-bleed) ── */
	.mission {
		padding: 4rem 0;
	}

	.mission__inner {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.mission__desc {
		margin: 0;
		max-width: 62ch;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-muted);
	}

	/* ── Audience ─────────────────────────────────── */
	.audience {
		background: var(--color-bg-alt);
		padding: 4rem 0;
	}

	.audience-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.audience-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.75rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 16px;
	}

	.audience-item__icon,
	.philosophy-item__icon {
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 10px;
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-success);
	}
	.audience-item__icon svg,
	.philosophy-item__icon svg {
		width: 1.3rem;
		height: 1.3rem;
	}

	.audience-item__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.audience-item__title {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.audience-item__desc {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--color-muted);
	}

	/* ── Philosophy ───────────────────────────────── */
	.philosophy {
		padding: 4rem 0;
	}

	.philosophy-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	.philosophy-item {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.5rem;
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: 16px;
	}

	.philosophy-item__title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.philosophy-item__desc {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	/* ── Contact ──────────────────────────────────── */
	.contact {
		background: var(--color-text);
		color: #fff;
		padding: 4rem 0;
	}

	.contact__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		text-align: center;
	}

	.contact__title {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #fff;
	}

	.contact__desc {
		margin: 0;
		max-width: 48ch;
		font-size: 1rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.66);
	}

	@media (max-width: 860px) {
		.about-hero, .mission, .audience, .philosophy, .contact {
			padding: 3rem 0;
		}
		.audience-grid {
			grid-template-columns: 1fr;
		}
		.philosophy-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.about-hero__inner,
		.mission__inner,
		.audience__inner,
		.philosophy__inner,
		.contact__inner {
			padding: 0 1.25rem;
		}
		.philosophy-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
