---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const postURL = new URL(Astro.url.pathname, Astro.site);
const blogPostingJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	articleSection: post.data.category,
	keywords: post.data.tags.join(', '),
	mainEntityOfPage: postURL.toString(),
	url: postURL.toString(),
	author: {
		'@type': 'Organization',
		name: 'Codivo Studio',
	},
	publisher: {
		'@type': 'Organization',
		name: 'Codivo Studio',
		logo: {
			'@type': 'ImageObject',
			url: new URL('/favicon.svg', Astro.site).toString(),
		},
	},
};
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	type="article"
	publishedDate={post.data.pubDate}
	articleSection={post.data.category}
	keywords={post.data.tags.join(', ')}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
	<article>
		<h1>{post.data.title}</h1>
		<div class="post-meta">
			<time datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString('ko-KR')}
			</time>
			{post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
		</div>
		<div class="post-body">
			<Content />
		</div>
	</article>
	<p><a href="/blog/">&larr; 목록으로</a></p>
</BaseLayout>

<style>
	.post-meta {
		font-size: 0.85rem;
		color: var(--color-muted);
		display: flex;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.tag {
		color: var(--color-accent);
	}

	.post-body {
		line-height: 1.8;
	}
</style>
