---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const tools = [
	{
		href: '/tools/rank-tracker',
		name: '실시간 랭킹추적',
		desc: '키워드 검색 시 내 상품이 몇 위에 노출되는지 실시간으로 확인합니다.',
		icon: 'M3 17h4v4H3z M10 11h4v10h-4z M17 4h4v17h-4z',
	},
	{
		href: '/tools/keyword-analysis',
		name: '연관 키워드 분석',
		desc: '연관 키워드의 검색량과 경쟁강도를 한 번에 분석합니다.',
		icon: 'circle',
	},
	{
		href: 'https://invoice-merge-codivo.streamlit.app/',
		name: '대량발송 엑셀변환기',
		desc: '네이버·쿠팡 주문 파일과 택배 송장 파일을 자동으로 매칭해 하나로 합쳐줍니다.',
		icon: 'table',
	},
];

const platforms = ['네이버 스마트스토어', '쿠팡', '택배 송장', '차량 정보 조회'];

const stats = [
	{ value: '3', label: '사용 가능한 도구' },
	{ value: '2', label: '타깃 사용자 그룹' },
	{ value: '무료', label: '도구 이용 요금' },
	{ value: '상시', label: '자동 실행' },
];

const whyItems = [
	{ title: '온라인 셀러 대응', desc: '주문 처리, 순위 확인, 키워드 분석까지 반복되는 판매 업무를 대신합니다.', icon: 'monitor' },
	{ title: '자동차 실무자 대응', desc: '차량 정보 조회 등 반복되는 확인 작업을 더 빠르고 정확하게 처리합니다.', icon: 'zap' },
	{ title: '실용성 우선', desc: '복잡한 기능보다 반복을 줄이는 실용적인 도구를 만듭니다.', icon: 'star' },
	{ title: '현장에서 검증', desc: '화려한 기능보다 실제로 작동하는 완성도를 먼저 봅니다.', icon: 'shield' },
];

const whyIcons: Record<string, string[]> = {
	monitor: ['M4 4h16v10H4z', 'M9 20h6', 'M12 14v6'],
	zap: ['M13 2 3 14h7l-1 8 10-12h-7z'],
	star: ['M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 7.1-1.01L12 2z'],
	shield: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', 'M9 12l2 2 4-4'],
};

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title="홈" description="Codivo Studio - 온라인 셀러와 자동차 실무자를 위한 실용적인 웹 도구">
	<section class="hero">
		<div class="hero__inner">
			<div class="hero__content">
				<h1 class="hero__title">단순하게.<br />정확하게.<br /><span class="hero__title-accent">빠르게.</span></h1>
				<p class="hero__desc">Codivo Studio는 온라인 판매자와 자동차 관련 실무자를 위한 간단하고 실용적인 웹 도구를 만듭니다.</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href="/tools">도구 둘러보기</a>
					<a class="btn btn--secondary" href="/about">Codivo Studio 소개</a>
				</div>
				<p class="hero__counter">누적 방문자 <strong data-visitor-count>–</strong>명</p>
			</div>

			<div class="hero__visual">
				<div class="dash">
					<div class="dash__bar">
						<span class="dash__dot dash__dot--red"></span>
						<span class="dash__dot dash__dot--yellow"></span>
						<span class="dash__dot dash__dot--green"></span>
					</div>
					<div class="dash__body">
						<div class="dash__side">
							<span class="dash__side-active">Overview</span>
							<span>랭킹추적</span>
							<span>키워드분석</span>
							<span>엑셀변환기</span>
						</div>
						<div class="dash__main">
							<p class="dash__heading">오늘의 요약</p>
							<div class="dash__stats">
								<div class="dash__stat">
									<span class="dash__stat-num">24</span>
									<span class="dash__stat-label">모니터링 상품</span>
								</div>
								<div class="dash__stat">
									<span class="dash__stat-num">156</span>
									<span class="dash__stat-label">등록 키워드</span>
								</div>
								<div class="dash__stat">
									<span class="dash__stat-num">3</span>
									<span class="dash__stat-label">사용 중인 도구</span>
								</div>
							</div>
							<svg class="dash__chart" viewBox="0 0 260 60" preserveAspectRatio="none" aria-hidden="true">
								<polyline
									points="0,45 30,30 60,38 90,15 120,25 150,10 180,20 210,8 240,18 260,5"
									fill="none"
									stroke="var(--color-success)"
									stroke-width="2"
								></polyline>
							</svg>
						</div>
					</div>
				</div>
				<div class="dash__float">
					<span class="dash__float-status">
						<i class="dash__float-dot" aria-hidden="true"></i>실시간 감시 중
					</span>
					<p class="dash__float-desc">5분마다 자동 확인</p>
				</div>
			</div>
		</div>
	</section>

	<section class="platforms">
		<div class="platforms__inner">
			<span class="platforms__label">지원 플랫폼</span>
			<div class="platforms__row">
				{platforms.map((name) => <span>{name}</span>)}
			</div>
		</div>
	</section>

	<section class="tools-section">
		<div class="tools-section__inner">
			<div class="section-head">
				<span class="eyebrow">TOOLS</span>
				<h2 class="section-title">필요한 도구를 지금 바로 사용해보세요</h2>
				<p class="section-desc">온라인 셀러를 위해 만든 실전 도구입니다. 아래에서 필요한 도구를 선택해 바로 사용해 보세요.</p>
			</div>

			<div class="tools-layout">
			<div class="tools-grid">
				<a class="tool-card" href={tools[0].href}>
					<div class="tool-card__head">
						<span class="tool-card__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M3 17h4v4H3z"></path>
								<path d="M10 11h4v10h-4z"></path>
								<path d="M17 4h4v17h-4z"></path>
							</svg>
						</span>
						<span class="tool-card__name">{tools[0].name}</span>
					</div>
					<p class="tool-card__desc">{tools[0].desc}</p>
					<div class="tool-card__demo">
						<div class="demo-row">
							<span>키워드</span><span>순위</span>
						</div>
						<div class="demo-row demo-row--data">
							<span>여름 원피스</span><span class="demo-row__hi">3위</span>
						</div>
						<div class="demo-row demo-row--data">
							<span>캠핑 의자</span><span>7위</span>
						</div>
					</div>
					<span class="tool-card__link">사용하기 →</span>
				</a>

				<a class="tool-card tool-card--highlight" href={tools[1].href}>
					<div class="tool-card__head">
						<span class="tool-card__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="7"></circle>
								<path d="M21 21l-4.3-4.3"></path>
							</svg>
						</span>
						<span class="tool-card__name">{tools[1].name}</span>
					</div>
					<p class="tool-card__desc">{tools[1].desc}</p>
					<div class="tool-card__steps">
						<span class="step">키워드 입력</span>
						<span class="step">검색량 확인</span>
						<span class="step step--done">
							<span class="step__check">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M5 13l4 4L19 7"></path>
								</svg>
							</span>
							경쟁강도 분석
						</span>
						<span class="step">추천 키워드 도출</span>
					</div>
					<span class="tool-card__link">사용하기 →</span>
				</a>

				<a class="tool-card" href={tools[2].href} target="_blank" rel="noopener noreferrer">
					<div class="tool-card__head">
						<span class="tool-card__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="3" y="3" width="18" height="18" rx="2"></rect>
								<path d="M3 9h18"></path>
								<path d="M9 21V9"></path>
							</svg>
						</span>
						<span class="tool-card__name">{tools[2].name}</span>
					</div>
					<p class="tool-card__desc">{tools[2].desc}</p>
					<div class="tool-card__demo tool-card__demo--file">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="4" width="18" height="16" rx="2"></rect>
							<path d="M3 10h18"></path>
							<path d="M9 10v10"></path>
						</svg>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14"></path>
							<path d="M13 6l6 6-6 6"></path>
						</svg>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tool-card__check" aria-hidden="true">
							<path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
							<path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"></path>
							<path d="M9.5 14.5l1.5 1.5 3-3"></path>
						</svg>
					</div>
					<span class="tool-card__link">사용하기 →</span>
				</a>
			</div>

			<div class="tools-stats">
				<div class="tools-stat">
					<span class="tools-stat__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="3" width="7" height="7" rx="1"></rect>
							<rect x="14" y="3" width="7" height="7" rx="1"></rect>
							<rect x="3" y="14" width="7" height="7" rx="1"></rect>
							<rect x="14" y="14" width="7" height="7" rx="1"></rect>
						</svg>
					</span>
					<div>
						<p class="tools-stat__value">{stats[0].value}</p>
						<p class="tools-stat__label">{stats[0].label}</p>
					</div>
				</div>
				<div class="tools-stat">
					<span class="tools-stat__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
							<circle cx="9" cy="7" r="4"></circle>
							<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
						</svg>
					</span>
					<div>
						<p class="tools-stat__value">{stats[1].value}</p>
						<p class="tools-stat__label">{stats[1].label}</p>
					</div>
				</div>
				<div class="tools-stat">
					<span class="tools-stat__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M20.59 13.41L11 3.83V3H3v8h.83l9.58 9.59a2 2 0 0 0 2.83 0l4.35-4.35a2 2 0 0 0 0-2.83z"></path>
							<circle cx="6.5" cy="6.5" r="1.5"></circle>
						</svg>
					</span>
					<div>
						<p class="tools-stat__value">{stats[2].value}</p>
						<p class="tools-stat__label">{stats[2].label}</p>
					</div>
				</div>
				<div class="tools-stat">
					<span class="tools-stat__icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 2v6h-6"></path>
							<path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
							<path d="M3 22v-6h6"></path>
							<path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
						</svg>
					</span>
					<div>
						<p class="tools-stat__value">{stats[3].value}</p>
						<p class="tools-stat__label">{stats[3].label}</p>
					</div>
				</div>
			</div>
		</div>
		</div>
	</section>

	<!-- 애드센스 광고 슬롯 (승인 후 스크립트/단위 교체 예정) -->
	<section class="ad-slot" aria-hidden="true">
		<span>광고 영역 (placeholder)</span>
	</section>

	<section class="why-section">
		<div class="why-section__inner">
			<div class="why-layout">
				<div class="why-copy">
					<span class="eyebrow">ABOUT CODIVO STUDIO</span>
					<h2 class="section-title">복잡한 기능보다,<br />반복을 줄이는 실용적인 도구를 만듭니다</h2>
					<a class="link-arrow" href="/about">Codivo Studio 더 알아보기 →</a>
				</div>

				<div class="why-grid">
					{
						whyItems.map((item) => (
							<div class="why-item">
								<span class="why-item__icon">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										{whyIcons[item.icon].map((d) => <path d={d} />)}
									</svg>
								</span>
								<p class="why-item__title">{item.title}</p>
								<p class="why-item__desc">{item.desc}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="posts-section">
				<div class="posts-section__inner">
					<div class="section-head">
						<span class="eyebrow">JOURNAL</span>
						<h2 class="section-title">최근 콘텐츠</h2>
					</div>
					<div class="posts-grid">
						{posts.map((post) => (
							<a class="post-card" href={`/blog/${post.id}/`}>
								<span class="post-card__category">{post.data.category}</span>
								<p class="post-card__title">{post.data.title}</p>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="cta-section" id="contact">
		<div class="cta-section__inner">
			<span class="eyebrow eyebrow--light">CONTACT</span>
			<h2 class="cta-title">반복되는 업무가 있다면 알려주세요</h2>
			<p class="cta-desc">현재 업무에서 반복하고 있는 작업이나 필요한 도구가 있다면 문의해 주세요. 실제로 사용할 수 있는 단순하고 실용적인 방법을 고민합니다.</p>
			<div class="cta-actions">
				<a class="btn btn--primary" href="/tools">도구 둘러보기</a>
				<ContactForm variant="outline" />
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	(async () => {
		const el = document.querySelector('[data-visitor-count]');
		if (!el) return;

		const alreadyCounted = sessionStorage.getItem('codivo_visit_counted');
		const increment = alreadyCounted ? '0' : '1';

		try {
			const res = await fetch(`/api/hit-count?increment=${increment}`);
			const data = await res.json();
			el.textContent = data.count.toLocaleString('ko-KR');
			if (!alreadyCounted) sessionStorage.setItem('codivo_visit_counted', '1');
		} catch {
			el.textContent = '–';
		}
	})();
</script>

<style>
	/* 공통: 풀블리드 섹션 (BaseLayout의 max-width 컨테이너를 벗어나 배경을 화면 끝까지 채움) */
	.hero,
	.platforms,
	.tools-section,
	.stats,
	.why-section,
	.posts-section,
	.cta-section {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
	}

	.hero__inner,
	.platforms__inner,
	.tools-section__inner,
	.stats__inner,
	.why-section__inner,
	.posts-section__inner,
	.cta-section__inner {
		max-width: 1360px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.eyebrow {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--color-accent);
	}

	.eyebrow--light {
		color: var(--color-accent);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 48px;
		padding: 0 1.7rem;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid transparent;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
	}

	.btn--primary {
		background: var(--color-accent);
		color: #fff;
	}
	.btn--primary:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	.btn--secondary {
		background: #fff;
		color: var(--color-text);
		border-color: var(--color-border);
	}
	.btn--secondary:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
		transform: translateY(-1px);
	}

	.btn--dark {
		background: transparent;
		color: #fff;
		border-color: rgba(255, 255, 255, 0.2);
	}
	.btn--dark:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.section-head {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin-bottom: 2.5rem;
	}

	.section-head--wide {
		max-width: 62ch;
		gap: 0.9rem;
	}

	.section-title {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.35;
		color: var(--color-text);
	}

	.section-desc {
		margin: 0;
		max-width: 52ch;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	/* ── Hero ─────────────────────────────────────── */
	.hero {
		background: var(--color-text) url('/images/bg-dark-orbit.jpg') center center / cover no-repeat;
		min-height: 700px;
		margin-top: -1rem;
		display: flex;
		align-items: center;
	}

	.hero__inner {
		width: 100%;
		display: grid;
		grid-template-columns: 45fr 55fr;
		gap: 3.5rem;
		align-items: center;
		padding: 0 3rem;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	.hero__title {
		margin: 0;
		font-size: clamp(2.2rem, 4.4vw, 3.2rem);
		font-weight: 800;
		line-height: 1.18;
		letter-spacing: -0.02em;
		color: #fff;
	}

	.hero__title-accent {
		color: var(--color-accent);
	}

	.hero__desc {
		margin: 0;
		max-width: 42ch;
