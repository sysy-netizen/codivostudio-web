---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const from = Astro.url.searchParams.get('from') ?? '';
---

<BaseLayout
	title="발송자동화 프로그램 베타 사전신청"
	description="엑셀 병합 후 네이버 발송처리까지 자동으로 전송해주는 로컬 실행 프로그램입니다. 베타 사전테스트 참가자를 모집합니다."
>
	<nav class="crumb" aria-label="breadcrumb">
		<a href="/">홈</a>
		<span>/</span>
		<a href="/tools/">도구</a>
		<span>/</span>
		<a href="/tools/excel-converter/">엑셀변환기</a>
		<span>/</span>
		<span aria-current="page">발송자동화 프로그램</span>
	</nav>

	<!-- ── 섹션 이동 탭 ───────────────────────────────────────── -->
	<nav class="section-nav" data-section-nav aria-label="페이지 내 섹션 이동">
		<a href="#intro" data-section-link class="is-active">프로그램 소개</a>
		<a href="#usage" data-section-link>사용 방법</a>
		<a href="#signup" data-section-link>베타 신청</a>
	</nav>

	<!-- ── 히어로 ─────────────────────────────────────────────── -->
	<section class="hero" id="intro">
		<div class="hero__copy">
			<span class="eyebrow">🧪 베타 사전테스트 모집 중</span>
			<p class="hero__scope">현재 <strong>로젠택배 송장 프로그램 이용자</strong>만 모집합니다</p>
			<h1 class="hero__title">주문 엑셀부터<br />발송처리까지, 한 번에</h1>
			<p class="hero__lead">
				엑셀 파일을 내려받고, 변환하고, 다시 업로드하는 반복 작업.<br class="br-desktop" />
				이제 PC에서 파일만 선택하면 발송처리까지 자동으로 진행됩니다.
			</p>
			<a class="hero__cta" href="#signup">베타 테스트 신청하기 →</a>
			<ul class="hero__badges">
				<li>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
					반복 작업 시간 절약
				</li>
				<li>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3.5v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9v-5L12 3z" /></svg>
					정확한 발송처리
				</li>
				<li>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M8 21h8M12 18v3" /></svg>
					Windows 설치형 프로그램
				</li>
			</ul>
		</div>

		<div class="mockup" aria-hidden="true">
			<div class="mockup__titlebar">
				<span>Codivo Dispatch</span>
				<span class="mockup__dots"><i></i><i></i><i></i></span>
			</div>
			<ol class="mockup__steps">
				<li>
					<span class="mockup__num">1</span>
					<div>
						<p class="mockup__step-title">주문 엑셀 파일 선택</p>
						<p class="mockup__step-hint">(네이버 파일 + 로젠 파일)</p>
					</div>
				</li>
				<li>
					<span class="mockup__num">2</span>
					<div>
						<p class="mockup__step-title">자동 병합 및 변환</p>
						<p class="mockup__step-hint">발송처리에 필요한 형식으로 자동 변환</p>
					</div>
				</li>
				<li>
					<span class="mockup__num mockup__num--done">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
					</span>
					<div>
						<p class="mockup__step-title">발송처리 완료</p>
						<p class="mockup__step-hint">로젠택배 운송장 등록까지 자동으로</p>
					</div>
				</li>
			</ol>
			<div class="mockup__success">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" /></svg>
				발송처리가 완료되었습니다.
			</div>
		</div>
	</section>

	<!-- ── 어떻게 달라지나요 ──────────────────────────────────── -->
	<section class="compare">
		<h2>어떻게 달라지나요?</h2>
		<p class="compare__lead">
			여전히 엑셀 파일을 내려받고, 변환하고, 다시 업로드하고 계신가요?<br class="br-desktop" />
			이제 한 번의 선택으로 발송처리까지 자동으로 진행됩니다.
		</p>

		<div class="compare__grid">
			<div class="flow flow--old">
				<p class="flow__label">기존 방식</p>
				<div class="flow__steps">
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></span>
						<span>엑셀<br />다운로드</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></span>
						<span>파일 2개<br />업로드</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg></span>
						<span>변환</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4" /><path d="M4 19h16" /></svg></span>
						<span>다운로드</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4.5 4.5 0 0 1-1-8.9A5 5 0 0 1 15.5 8H16a4 4 0 0 1 1 7.9" /><path d="M12 12v8m0-8l-3 3m3-3l3 3" /></svg></span>
						<span>스마트스토어<br />업로드</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="14" height="10" rx="1" /><path d="M15 10h4l3 3v4h-7z" /><circle cx="6" cy="19" r="1.5" /><circle cx="18" cy="19" r="1.5" /></svg></span>
						<span>발송처리</span>
					</div>
				</div>
			</div>

			<div class="compare__divider" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
			</div>

			<div class="flow flow--new">
				<p class="flow__label">발송자동화 프로그램</p>
				<div class="flow__steps">
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></span>
						<span>내 PC에서<br />자동으로 파일 선택</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg></span>
						<span>자동 병합·변환</span>
					</div>
					<span class="flow__arrow">→</span>
					<div class="flow__step flow__step--final">
						<span class="flow__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="14" height="10" rx="1" /><path d="M15 10h4l3 3v4h-7z" /><circle cx="6" cy="19" r="1.5" /><circle cx="18" cy="19" r="1.5" /></svg></span>
						<span>발송처리까지<br />자동 완료 ✓</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── 안전성 ─────────────────────────────────────────────── -->
	<section class="trust">
		<h2>안전하고 믿을 수 있는 프로그램</h2>
		<div class="trust__grid">
			<div class="trust__card">
				<span class="trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg></span>
				<h3>내 PC에서 실행</h3>
				<p>주문 파일과 개인정보가 외부 서버로 전송되지 않습니다. 본인의 PC에서만 실행되는 설치형 프로그램입니다.</p>
			</div>
			<div class="trust__card">
				<span class="trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3.5v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9v-5L12 3z" /></svg></span>
				<h3>API 키 직접 관리</h3>
				<p>네이버 발송처리 API는 내 PC에서만 호출되며, API 키를 서버에 저장하지 않습니다. 본인이 직접 등록하여 사용합니다.</p>
			</div>
			<div class="trust__card">
				<span class="trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span>
				<h3>실제 주문으로 함께 검증</h3>
				<p>현재 베타 테스트 단계로, 정식 출시 전에 실제 주문 환경에서 소수의 판매자와 함께 충분히 검증합니다.</p>
			</div>
		</div>
	</section>

	<!-- ── 참가 조건 ──────────────────────────────────────────── -->
	<section class="requirements">
		<h2>베타 참가자에게 필요한 것</h2>
		<div class="requirements__grid">
			<div class="requirements__item requirements__item--required">
				<span class="requirements__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="14" height="10" rx="1" /><path d="M15 10h4l3 3v4h-7z" /><circle cx="6" cy="19" r="1.5" /><circle cx="18" cy="19" r="1.5" /></svg></span>
				<div>
					<p class="requirements__title">로젠택배 송장 프로그램 사용 중 <span class="requirements__badge">필수</span></p>
					<p class="requirements__hint">현재 로젠택배로 발송 처리를 하고 계신 분만 신청 가능합니다</p>
				</div>
			</div>
			<div class="requirements__item">
				<span class="requirements__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" /></svg></span>
				<div>
					<p class="requirements__title">네이버 스마트스토어 판매자 계정</p>
					<p class="requirements__hint">(커머스API 사용 가능해야 함)</p>
				</div>
			</div>
			<div class="requirements__item">
				<span class="requirements__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M8 21h8M12 18v3" /></svg></span>
				<div>
					<p class="requirements__title">Windows PC</p>
					<p class="requirements__hint">(설치형 프로그램)</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ── 사용 방법 ──────────────────────────────────────────── -->
	<section class="usage" id="usage">
		<h2>실제로 사용할 땐 이렇게 진행됩니다</h2>
		<p class="usage__lead">베타 참가가 확정되면 아래 순서로 딱 한 번만 준비하시면 됩니다. 이후에는 평소처럼 파일만 받아두면 됩니다.</p>

		<ol class="usage__steps">
			<li class="usage__step">
				<span class="usage__num">1</span>
				<div>
					<p class="usage__title">네이버 커머스API 키 발급</p>
					<p class="usage__desc">네이버 판매자센터에서 커머스API 사용을 신청하고 API 키(Client ID/Secret)를 발급받습니다.</p>
				</div>
			</li>
			<li class="usage__step">
				<span class="usage__num">2</span>
				<div>
					<p class="usage__title">내 PC의 IP를 네이버에 등록</p>
					<p class="usage__desc">발송처리 API는 등록된 IP에서만 호출할 수 있어서, 판매자센터에 내 PC의 IP를 추가로 등록합니다.</p>
				</div>
			</li>
			<li class="usage__step">
				<span class="usage__num">3</span>
				<div>
					<p class="usage__title">프로그램 설치 및 API 키 등록</p>
					<p class="usage__desc">전달받은 프로그램을 설치하고, 발급받은 API 키를 한 번만 입력해 등록합니다.</p>
				</div>
			</li>
			<li class="usage__step usage__step--final">
				<span class="usage__num">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
				</span>
				<div>
					<p class="usage__title">이후엔 평소처럼 파일만 받아두면 끝</p>
					<p class="usage__desc">네이버·로젠에서 받은 파일을 다운로드 폴더에 그대로 두고 프로그램을 실행하면, 자동 병합부터 발송처리까지 한 번에 진행됩니다.</p>
				</div>
			</li>
		</ol>

		<p class="usage__note">📋 설치·등록 방법은 베타 참가자에게 별도 안내 문서로 자세히 제공됩니다. 지금은 사전신청만 해두시면 됩니다.</p>
	</section>

	<!-- ── 신청 ───────────────────────────────────────────────── -->
	<section class="signup" id="signup">
		<div class="signup__intro">
			<span class="eyebrow eyebrow--dark">JOIN BETA TEST</span>
			<h2>베타 테스트에<br />참여해 주세요</h2>
			<p>실제 주문 환경에서 프로그램을 먼저 사용해보고 개선에 참여하실 스마트스토어 판매자를 모집합니다.</p>
			<ul class="signup__checklist">
				<li>✅ 무료 베타 테스트</li>
				<li>✅ 설치비 없음</li>
				<li>✅ 지금 바로 신청하고, 더 편한 발송 업무를 경험하세요</li>
			</ul>
			<p class="signup__scope">⚠️ 현재는 <strong>로젠택배 송장 프로그램을 사용 중인 판매자만</strong> 신청 가능합니다.</p>
		</div>

		<form class="signup__form" data-dispatch-signup-form>
			<input type="hidden" name="access_key" value="4315b321-6c19-4c4c-9ed4-01308b80c20e" />
			<input type="hidden" name="subject" value="발송자동화 프로그램 베타 사전신청" />
			<input type="hidden" name="관심 택배사" value={from} />

			<div class="signup__row">
				<label class="signup__field">
					<span>이름 / 상호명 *</span>
					<input type="text" name="name" placeholder="예) 김코디 / 코디보물" required />
