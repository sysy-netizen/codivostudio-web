<script>
	const form = document.querySelector<HTMLFormElement>('[data-dispatch-signup-form]');
	const status = form?.querySelector<HTMLParagraphElement>('.signup__status');
	const submitBtn = form?.querySelector<HTMLButtonElement>('.signup__submit');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!submitBtn || !status) return;

		submitBtn.disabled = true;
		status.textContent = '전송 중...';

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});
			const result = await response.json();

			if (result.success) {
				status.textContent = '신청이 접수되었습니다. 베타 프로그램 준비되는 대로 이메일로 안내드릴게요!';
				form.reset();
			} else {
				status.textContent = '전송에 실패했습니다. 잠시 후 다시 시도해주세요.';
			}
		} catch {
			status.textContent = '전송에 실패했습니다. 네트워크 연결을 확인해주세요.';
		} finally {
			submitBtn.disabled = false;
		}
	});

	// 섹션 이동 탭: 클릭 시 부드럽게 스크롤 + 현재 보고 있는 섹션 자동 강조
	const sectionNav = document.querySelector<HTMLElement>('[data-section-nav]');
	const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
	const sections = sectionLinks
		.map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
		.filter((el): el is HTMLElement => el !== null);

	function setActiveLink(id: string) {
		sectionLinks.forEach((link) => {
			link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`);
		});
	}

	if (sectionNav && sections.length === sectionLinks.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries.filter((entry) => entry.isIntersecting);
				if (visible.length > 0) {
					setActiveLink(visible[0].target.id);
				}
			},
			{ rootMargin: `-${sectionNav.offsetHeight + 16}px 0px -60% 0px`, threshold: 0 }
		);
		sections.forEach((section) => observer.observe(section));
	}
</script>

