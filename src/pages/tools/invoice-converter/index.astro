---
import ProgramLayout from '../../../layouts/ProgramLayout.astro';
---

<ProgramLayout
	title="대량발송 엑셀변환기"
	description="네이버·쿠팡 주문 파일과 택배 송장 파일을 자동으로 매칭해 하나로 합쳐줍니다."
	relatedHref="/blog/naver-coupang-order-invoice-merge-automation/"
	relatedLabel="네이버·쿠팡 주문서, 송장 파일과 자동으로 합치는 법"
>
	<iframe
		class="tool-page__frame"
		src="https://invoice-merge-codivo.streamlit.app/"
		title="대량발송 엑셀변환기"
		height="900"
	></iframe>
</ProgramLayout>

<style>
	.tool-page__frame {
		display: block;
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		height: 900px;
		border: 1px solid var(--color-border);
		border-left: none;
		border-right: none;
		border-radius: 0;
	}
</style>
