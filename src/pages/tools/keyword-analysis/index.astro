---
import ProgramLayout from '../../../layouts/ProgramLayout.astro';
---

<ProgramLayout
	title="연관 키워드 분석"
	description="연관 키워드의 검색량과 경쟁강도를 한 번에 분석합니다."
	relatedHref="/blog/related-keyword-analysis-product-exposure/"
	relatedLabel="연관 키워드 분석으로 상품 노출 늘리는 법"
>
	<iframe
		class="tool-page__frame"
		src="https://tools.codivostudio.com/keyword"
		title="연관 키워드 분석"
		height="800"
	></iframe>
</ProgramLayout>

<style>
	.tool-page__frame {
		display: block;
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		height: 800px;
		border: 1px solid var(--color-border);
		border-left: none;
		border-right: none;
		border-radius: 0;
	}
</style>
