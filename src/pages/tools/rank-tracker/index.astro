---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const tools = [
	{ href: '/tools/rank-tracker', name: '실시간 랭킹추적' },
	{ href: '/tools/keyword-analysis', name: '연관 키워드 분석' },
	{ href: '/tools/invoice-converter', name: '대량발송 엑셀변환기' },
];
const currentHref = '/tools/rank-tracker';
---

<BaseLayout title="실시간 랭킹추적" description="키워드 검색 시 내 상품이 몇 위에 노출되는지 실시간으로 확인합니다.">
	<section class="tool-page">
		<h1 class="tool-page__title">실시간 랭킹추적</h1>
		<p class="tool-page__desc">키워드 검색 시 내 상품이 몇 위에 노출되는지 실시간으로 확인합니다.</p>
		<p class="tool-page__related">관련 글: <a href="/blog/naver-keyword-rank-real-time-check/">네이버 키워드 순위, 하루에 한 번만 확인하면 안 되는 이유</a></p>
		<nav class="tool-switcher" aria-label="다른 도구로 이동">
			{
				tools.map((tool) => (
					<a
						href={tool.href}
						class={`tool-switcher__btn ${tool.href === currentHref ? 'is-active' : ''}`}
						aria-current={tool.href === currentHref ? 'page' : undefined}
					>
						{tool.name}
					</a>
				))
			}
		</nav>
		<iframe
			class="tool-page__frame"
			src="https://tools.codivostudio.com/"
			title="실시간 랭킹추적"
			height="800"
		></iframe>
	</section>
</BaseLayout>

<style>
	.tool-page {
		padding: 0 0 2rem;
		margin-top: -0.5rem;
	}

	.tool-page__title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.tool-page__desc {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.tool-page__related {
		margin: 0 0 1.5rem;
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.tool-switcher {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0 0 1.5rem;
	}

	.tool-switcher__btn {
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
		background: #fff;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.tool-switcher__btn:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	.tool-switcher__btn.is-active {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	.tool-page__frame {
		display: block;
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		height: 800px;
		border: 1px solid var(--color-border);
		border-left: none;
		border-right: none;
		border-radius: 0;
	}
</style>
