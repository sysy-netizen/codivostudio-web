---
import ProgramLayout from '../../../layouts/ProgramLayout.astro';
---

<ProgramLayout
	title="실시간 랭킹추적"
	description="키워드 검색 시 내 상품이 몇 위에 노출되는지 실시간으로 확인합니다."
	relatedHref="/blog/naver-keyword-rank-real-time-check/"
	relatedLabel="네이버 키워드 순위, 하루에 한 번만 확인하면 안 되는 이유"
>
	<iframe
		class="tool-page__frame"
		src="https://tools.codivostudio.com/"
		title="실시간 랭킹추적"
		height="800"
	></iframe>
</ProgramLayout>

<style>
	.tool-page__frame {
		display: block;
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		height: 800px;
		border: 1px solid var(--color-border);
		border-left: none;
		border-right: none;
		border-radius: 0;
	}
</style>
